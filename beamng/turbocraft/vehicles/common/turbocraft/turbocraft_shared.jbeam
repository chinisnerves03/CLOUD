    "mainEngine": {
      "instantAfterFireCoef": 1,
      "sustainedAfterFireCoef": 0.12,
      "sustainedAfterFireTime": 0.15,
      "instantAfterFireVolumeCoef": "$=$tcDriftBang*0.01",
      "sustainedAfterFireVolumeCoef": "$=$tcDriftBang*0.006",
      "shiftAfterFireVolumeCoef": "$=$tcDriftBang*0.025",
      "turbocraftEffectsProfile": "drift",
      "turbocraftAfterfireMinRPM": "$tcDriftFlameMinRPM",
      "turbocraftFlameChance": "$tcDriftFlame",
      "afterFireVisualThresholdInstant": "$=$tcDriftFlame > 0 and 500000*25/$tcDriftFlame or 1e30",
      "afterFireVisualThresholdSustained": "$=$tcDriftFlame > 0 and 150000*25/$tcDriftFlame or 1e30",
      "afterFireVisualThresholdShift": "$=$tcDriftFlame > 0 and 1e+06*25/$tcDriftFlame or 1e30"
    }
  },
