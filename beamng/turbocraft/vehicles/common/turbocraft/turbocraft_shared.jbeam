  "turbocraft_engine_effects_native": {
    "information": {
      "authors": "TurboCraft Project",
      "name": "Factory Exhaust Effects",
      "value": 0
    },
    "slotType": "turbocraft_engine_effects"
  },
  "turbocraft_engine_effects_overrun": {
    "information": {
      "authors": "TurboCraft Project",
      "value": 200,
      "name": "Custom Pops & Flames · Factory Limiter"
    },
    "slotType": "turbocraft_engine_effects",
    "variables": [
      [
        "name",
        "type",
        "unit",
        "category",
        "default",
        "min",
        "max",
        "title",
        "description"
      ],
      [
        "$tcAfterfireFuel",
        "range",
        "",
        "TurboCraft Advanced Effects",
        1,
        0,
        1.5,
        "Lift-Off Fuel",
        "More fuel after lifting can make exhaust pops easier to trigger",
        {
          "stepDis": 0.05
        }
      ],
      [
        "$tcAfterfireSustain",
        "range",
        "",
        "TurboCraft Advanced Effects",
        0.5,
        0,
        1.5,
        "Pop Sustain",
        "Fuel available between pops; 0 turns sustained pops off",
        {
          "stepDis": 0.05
        }
      ],
      [
        "$tcAfterfireDuration",
        "range",
        "s",
        "TurboCraft Advanced Effects",
        0.4,
        0,
        1.5,
        "Pop Time Window",
        "How long off-throttle pops can continue",
        {
          "stepDis": 0.05
        }
      ],
      [
        "$tcFlame",
        "range",
        "%",
        "TurboCraft Advanced Effects",
        100,
        0,
        100,
        "Flame Chance",
        "0 = off; higher values make exhaust flames easier to trigger",
        {
          "stepDis": 5
        }
      ],
      [
        "$tcBang",
        "range",
        "%",
        "TurboCraft Advanced Effects",
        80,
        0,
        150,
        "Pop & Bang Volume",
        "Changes exhaust pops only; BOV and turbo sound stay separate",
        {
          "stepDis": 5
        }
      ]
    ],
    "mainEngine": {
      "instantAfterFireCoef": "$tcAfterfireFuel",
      "sustainedAfterFireCoef": "$tcAfterfireSustain",
      "sustainedAfterFireTime": "$tcAfterfireDuration",
      "instantAfterFireVolumeCoef": "$=$tcBang*0.01",
      "sustainedAfterFireVolumeCoef": "$=$tcBang*0.01",
      "shiftAfterFireVolumeCoef": "$=$tcBang*0.02",
      "turbocraftEffectsProfile": "overrun",
      "turbocraftFlameChance": "$tcFlame",
      "afterFireVisualThresholdInstant": "$=$tcFlame > 0 and 500000*25/$tcFlame or 1e30",
      "afterFireVisualThresholdSustained": "$=$tcFlame > 0 and 150000*25/$tcFlame or 1e30",
      "afterFireVisualThresholdShift": "$=$tcFlame > 0 and 1e+06*25/$tcFlame or 1e30"
    }
  },
