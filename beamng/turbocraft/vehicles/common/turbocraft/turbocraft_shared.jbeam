  "turbocraft_engine_effects_drift": {
    "information": {
      "authors": "TurboCraft Project",
      "value": 200,
      "name": "Easy Pops & Flames"
    },
    "slotType": "turbocraft_engine_effects",
    "variables": [
      [
        "name",
        "type",
        "unit",
        "category",
        "default",
        "min",
        "max",
        "title",
        "description"
      ],
      [
        "$tcDriftFlame",
        "range",
        "%",
        "TurboCraft Easy Effects",
        100,
        0,
        100,
        "Flame Chance",
        "0 = off; higher values make exhaust flames easier to trigger",
        {
          "stepDis": 5
        }
      ],
      [
        "$tcDriftBang",
        "range",
        "%",
        "TurboCraft Easy Effects",
        110,
        0,
        150,
        "Pop & Bang Volume",
        "0 = mute exhaust pops; BOV and turbo sound stay separate",
        {
          "stepDis": 5
        }
      ],
      [
        "$tcDriftFlameMinRPM",
        "range",
        "RPM",
        "TurboCraft Easy Effects",
        0,
        0,
        15000,
        "Minimum Flame RPM",
        "0 = any RPM; below this RPM, exhaust flames are hidden",
