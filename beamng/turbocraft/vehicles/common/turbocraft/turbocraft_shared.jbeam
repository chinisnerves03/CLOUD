  "turbocraft_turbo_audio_adjust": {
    "information": {
      "authors": "TurboCraft Project",
      "name": "Turbo Audio - Adjustable - Tuning",
      "value": 0
    },
    "slotType": "turbocraft_turbo_audio",
    "variables": [
      [
        "name",
        "type",
        "unit",
        "category",
        "default",
        "min",
        "max",
        "title",
        "description"
      ],
      [
        "$turbocraftSpoolVolume",
        "range",
        "%",
        "TurboCraft Audio",
        100,
        0,
        200,
        "Turbo Spool Volume",
        "Whistle and shaft whine; 100% is Loud",
        {
          "stepDis": 5
        }
      ],
      [
        "$turbocraftAirVolume",
        "range",
        "%",
        "TurboCraft Audio",
        100,
        0,
        200,
        "Turbo Intake / Air Volume",
        "Pre-boost intake and pressurized airflow",
        {
          "stepDis": 5
        }
      ],
      [
        "$turbocraftValveVolume",
        "range",
        "%",
        "TurboCraft Audio",
        100,
        0,
        200,
        "BOV / Flutter Volume",
        "Native valve and surge sounds",
        {
          "stepDis": 5
        }
      ],
      [
        "$turbocraftCabinGain",
        "range",
        "dB",
        "TurboCraft Audio",
        6,
        0,
        12,
        "Cabin Induction Compensation",
        "Boost only TurboCraft induction while the player camera is inside",
        {
          "stepDis": 1
        }
      ]
    ],
    "turbocharger": {
      "$*whineVolumePer10kRPM": "$=$turbocraftSpoolVolume*0.01",
      "$*hissVolumePerPSI": "$=$turbocraftAirVolume*0.01",
      "$*bovSoundVolumeCoef": "$=$turbocraftValveVolume*0.01",
      "$*flutterSoundVolumeCoef": "$=$turbocraftValveVolume*0.01",
      "turbocraftIntakeVolume": "$=$turbocraftAirVolume*0.01",
      "turbocraftSpoolVolume": "$=$turbocraftSpoolVolume*0.01",
      "turbocraftAirVolume": "$=$turbocraftAirVolume*0.01",
      "turbocraftCabinGainDB": "$turbocraftCabinGain"
    }
  },
  "turbocraft_turbo_audio_drift": {
    "information": {
      "authors": "TurboCraft Project",
      "name": "Easy Turbo Sound",
      "value": 0
    },
    "slotType": "turbocraft_turbo_audio",
    "variables": [
      [
        "name",
        "type",
        "unit",
        "category",
        "default",
        "min",
        "max",
        "title",
        "description"
      ],
      [
        "$tcDriftPresence",
        "range",
        "%",
        "TurboCraft Easy",
        100,
        0,
        125,
        "Sound Presence",
        "One control for spool, intake and native BOV/flutter; 100% is the drift mix",
        {
          "stepDis": 5
        }
      ],
      [
        "$turbocraftCabinGain",
        "range",
        "dB",
        "TurboCraft Easy",
        6,
        0,
        12,
        "Cabin Balance",
        "Induction compensation inside only; reduce if it masks the engine",
        {
          "stepDis": 1
        }
      ]
    ],
    "turbocharger": {
      "$*whineVolumePer10kRPM": "$=$tcDriftPresence*0.01*1.2",
      "$*hissVolumePerPSI": "$=$tcDriftPresence*0.01*1.15",
      "$*bovSoundVolumeCoef": "$=$tcDriftPresence*0.01*1.4",
      "$*flutterSoundVolumeCoef": "$=$tcDriftPresence*0.01*1.4",
      "turbocraftIntakeVolume": "$=$tcDriftPresence*0.01*1.15",
      "turbocraftSpoolVolume": "$=$tcDriftPresence*0.01*1.2",
      "turbocraftAirVolume": "$=$tcDriftPresence*0.01*1.15",
      "turbocraftCabinGainDB": "$turbocraftCabinGain"
    }
  },
