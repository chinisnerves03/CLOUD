      "afterFireVisualThresholdShift": "$=$tcFlame > 0 and 1e+06*25/$tcFlame or 1e30",
      "hasRevLimiter": true,
      "revLimiterType": "timeBased",
      "revLimiterCutTime": "$tcLimiterCut"
